OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
# Leave OPENAI_API_BASE empty to use OpenAI. Set it to use a free provider:
#
# Groq (https://console.groq.com/keys):
#   base = https://api.groq.com/openai/v1
#   models with working tool calling (tested 2026-09):
#     openai/gpt-oss-120b   (200k tokens/day free)
#     qwen/qwen3.8-27b      (200k tokens/day free)
#   compound / compound-mini do NOT support tool calling (400 error).
#
# Cloudflare Workers AI (https://dash.cloudflare.com):
#   base = https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1
#   key  = API token with Account > Workers AI > Edit permission
#   model = @cf/meta/llama-4-scout-17b-16e-instruct  (tool calling works, 131k ctx)
#           @cf/meta/llama-3.3-70b-instruct-fp8-fast (if scout is blocked on free plan)
#   free tier: 10,000 neurons/day, text generation ~300 requests/min.
#   Avoid @cf/openai/gpt-oss-* on this endpoint (spec incompatibility with chat completions).
#
# Google AI Studio:
#   base = https://generativelanguage.googleapis.com/v1beta/openai/
#   NOTE: gemini-3.6-flash requires thought_signature for multi-turn tool calls,
#   which broke this agent. Testing needed per model.
OPENAI_API_BASE=

# Optional agent tuning (defaults shown):
#   QA_PACING=8     seconds of spacing between model calls (3-4 is fine on fast
#                   providers like Cloudflare; raise if you hit 429s)
#   QA_MAX_STEPS=45 action budget before the agent must produce its final report
#   QA_SESSIONS_DIR=sessions   folder of per-domain saved login sessions (storage_state);
#                              authenticate once, later runs reuse the cookies.

# Eval harness (run from this project root):
#   venv\Scripts\python.exe --directory eval_app -m http.server 8765   (or use eval_app\evaluate.py which serves it)
#   venv\Scripts\python.exe eval_app\evaluate.py --mock             (score a canned report, no model)
#   venv\Scripts\python.exe eval_app\evaluate.py                    (full graded run against seeded bugs)